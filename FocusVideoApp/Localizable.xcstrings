{
  "sourceLanguage" : "ja",
  "strings" : {
    "「%@」の保存先を変更します" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Change the destination for \"%@\"." } }
      }
    },
    "「%@」を削除します。含まれるサブフォルダ %lld 件、動画 %lld 件も削除されます。" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete \"%1$@\". Included subfolders (%2$lld) and videos (%3$lld) will also be deleted." } }
      }
    },
    "「%@」内にサブフォルダを作成します" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Create a subfolder inside \"%@\"." } }
      }
    },
    "%@ を挿入" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Insert %@" } }
      }
    },
    "%@、集中し直す区間 %@ から再生" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@, play from refocus section %2$@" } }
      }
    },
    "%@。もう一度試してください" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@. Please try again." } }
      }
    },
    "%@は %@ 集中できました。" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You focused for %2$@ on %1$@." } }
      }
