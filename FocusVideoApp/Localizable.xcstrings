    "1日に最も長く集中できた時間" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your longest focused stretch each day" } }
      }
    },
    "1日の通知セット上限" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Daily reminder set limit" } }
      }
    },
    "5分経ちました。先延ばしにしないほうが楽です。短く戻りましょう。" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "5 minutes have passed. It is easier not to put this off. Come back briefly." } }
      }
    },
    "10分経ちました。そろそろ戻りましょう。長く空けるほど再開が重くなります。" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "10 minutes have passed. It is time to come back. The longer the gap, the harder restarting gets." } }
      }
    },
    "20:15 または 1:05:30" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "20:15 or 1:05:30" } }
      }
    },
    "Home" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Home" } }
      }
    },
    "iPhoneの「設定」アプリで「Selova」>「通知」を開き、「通知を許可」をオンにしてください。" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Settings on your iPhone, go to Selova > Notifications, and turn on Allow Notifications." } }
      }
    },
    "Lv. %lld" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Lv. %lld" } }
